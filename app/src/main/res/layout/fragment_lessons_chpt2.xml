                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/circular_button"
                android:elevation="12dp"
                android:fontFamily="@font/nunito_bold"
                android:textColor="@color/buttonTextColor"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/levelTitle3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/lesson_greeting_sorry"
                android:fontFamily="@font/nunito_bold"
                android:textColor="@color/buttonTextColor"
                android:textSize="18sp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"/>

            <LinearLayout
                android:id="@+id/dot_divider3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_weight="0"
                    android:src="@drawable/dot"
                    app:tint="@color/accentButtonColor" />

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_weight="0"
                    android:src="@drawable/dot"
                    app:tint="@color/accentButtonColor" />

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_weight="0"
                    android:src="@drawable/dot"
                    app:tint="@color/accentButtonColor" />
            </LinearLayout>

            <Button
                android:id="@+id/c2lvl4"
                style="@style/Widget.Senyas.Button.White"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/circular_button"
                android:elevation="12dp"
                android:fontFamily="@font/nunito_bold"
                android:textColor="@color/buttonTextColor"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/levelTitle4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/lesson_greeting_thank_you_formal"
                android:fontFamily="@font/nunito_bold"
                android:textColor="@color/buttonTextColor"
                android:textSize="18sp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"/>

            <LinearLayout
                android:id="@+id/dot_divider4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_weight="0"
                    android:src="@drawable/dot"
                    app:tint="@color/accentButtonColor" />

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_weight="0"
                    android:src="@drawable/dot"
                    app:tint="@color/accentButtonColor" />

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_weight="0"
                    android:src="@drawable/dot"
                    app:tint="@color/accentButtonColor" />
            </LinearLayout>

            <Button
                android:id="@+id/c2lvl5"
