<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme -->
    <style name="Base.Theme.Senyas" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Lock the theme to light mode -->
        <item name="android:statusBarColor">@color/secondaryColor</item>
        <item name="android:navigationBarColor">@color/backgroundColor</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>

        <!-- Primary colors -->
        <item name="colorPrimary">@color/primaryColor</item>
        <item name="colorPrimaryVariant">#0074B3</item>
        <item name="colorOnPrimary">@color/buttonTextColor</item>

        <!-- Secondary colors -->
        <item name="colorSecondary">@color/secondaryColor</item>
        <item name="colorOnSecondary">@color/primaryColor</item>

        <!-- Background -->
        <item name="android:colorBackground">@color/backgroundColor</item>

        <!-- Prevent Material3 from overriding button colors -->
        <item name="materialButtonStyle">@style/Widget.Senyas.Button</item>
        <item name="android:buttonStyle">@style/Widget.Senyas.Button</item>
    </style>

    <style name="Theme.Senyas" parent="Base.Theme.Senyas" />
    <style name="Theme.Gabay" parent="Base.Theme.Senyas" />
    <style name="ThemeSenyas" parent="Base.Theme.Senyas" />

    <!-- Custom button style -->
    <style name="Widget.Senyas.Button" parent="Widget.Material3.Button">
        <!-- Background tint controls the button fill color -->
        <item name="backgroundTint">@color/secondaryColor</item>
        <!-- Text color -->
        <item name="android:textColor">@color/primaryColor</item>
        <!-- Rounded corners -->
        <item name="cornerRadius">12dp</item>
        <!-- Slight shadow -->
        <item name="android:elevation">8dp</item>
    </style>

    <style name="Widget.Senyas.Button.White" parent="Widget.Senyas.Button">
        <item name="android:background">@drawable/circular_button_selector</item>
        <item name="android:textColor">@android:color/black</item>
    </style>

    <!-- CardView corner customization -->
    <style name="custom_card_view_style" parent="Widget.MaterialComponents.CardView">
        <item name="shapeAppearanceOverlay">@style/custom_card_view</item>
    </style>

    <style name="custom_card_view">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopRight">48dp</item>
        <item name="cornerSizeTopLeft">48dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
    </style>

</resources>
